# resman.yaml — copy to config/resman.yaml (repo default) or to
# ~/.resman.yaml (per-user override; takes priority), then edit.
# All paths are absolute; vaults may live anywhere on the filesystem.

app:
  host: 127.0.0.1
  port: 5090
  tmux_socket: resman              # isolated tmux socket name
  tmux_prefix: "rsm-"
  scrollback_limit: 10000
  claude_cmd: "claude --dangerously-skip-permissions"
  obsidian_cmd: "flatpak run md.obsidian.Obsidian"
  # Origin of the remdev deploy that renders the footer's Claude status bar
  # (iframe) and hosts the Windows-management UI (its Claude tab). Leave it
  # unset — the normal case, remdev on the same station: the browser then
  # builds the iframe URL from whatever address you opened resman on, plus
  # port 6005. Do NOT pin 127.0.0.1: an iframe src is fetched by the
  # *viewer's* machine, so a loopback pin blanks the bar on every device
  # except the station. Pin a real origin only when remdev lives on another
  # host, listens elsewhere, or must be reached over HTTPS (an HTTPS page
  # cannot embed a plain-HTTP bar).
  # remdev_url: "http://station:6005"
  # Terminals are served by the shared webterm library, inside resman's own
  # process — no ports, no iframe. RESMAN_WEBTERM=0 reverts to the legacy
  # ttyd stack, which is what the two ttyd_* keys below configure.
  ttyd_port_base: 7680             # legacy terminal only: ttyd port range
  ttyd_port_max: 7999
  # Optional: absolute path used as the starting point for the New Vault
  # wizard's path input and the Browse-folder picker. Speeds up adding
  # vaults that all live under a common root. Leave unset to start blank.
  # vault_default_root_path: /home/user/vaults

window_budget:
  weekly_start: "Monday 09:00"
  weekly_end:   "Sunday 23:00"

# Inbox tab: cross-vault feed of recently-added (unread) wiki pages.
inbox:
  # Page names hidden from the feed — handy for hub pages that get rewritten
  # on every ingest. Matched case-insensitively (and ignoring a trailing
  # ".md") against each page's name AND its full wiki path: "index" hides
  # every index.md, while "concepts/scratch" hides exactly that one page.
  ignore_pages: [index, hot, overview]

# Optional: explicit ordering for the sidebar category tree. Categories used
# by vaults but not listed here are appended alphabetically. Nested
# categories are addressed by their full slash path ("hw/edge").
# categories: [work, hw, hw/edge, garage]

# Each vault has its own explicit path — no required common root.
vaults:
  - name: example-vault
    path: /tmp/example-vault
    tags: [example]
    # Optional: sidebar category group. Slash nests ("hw/edge", max 3
    # levels); segments may use letters, numbers, spaces, . _ -
    # Vaults without a category sit at the root of the sidebar tree.
    # category: garage
    # Optional: bind-mount this vault's directory onto a host path so it is
    # accessible at a convenient location without symlinks.
    # Requires root or a passwordless sudoers entry — see man/mounts.md.
    # mount: /home/user/example-vault

# Optional: directories to scan for unregistered vaults (folders containing .obsidian/).
# Remove or leave empty to disable discovery. Max scan depth is 2 levels.
scan_paths: []
